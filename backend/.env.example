# AgentRank backend settings. Copy this file to backend/.env and fill in what you need.
# Only GROQ_API_KEY is required; everything else has a working default.

# ---------- LLM (required) ----------
# Free key: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here
# Any OpenAI-compatible endpoint works; switching provider is these three settings.
# AGENTRANK_LLM_BASE_URL=https://api.groq.com/openai/v1
# AGENTRANK_LLM_MODEL=openai/gpt-oss-120b
# AGENTRANK_LLM_FALLBACK_MODEL=openai/gpt-oss-20b

# ---------- Database and queue ----------
# Default: SQLite file + audits run inside the API process (no Docker needed).
# With `docker compose up -d`, uncomment these three for Postgres + Redis + a Celery worker.
# AGENTRANK_DATABASE_URL=postgresql+psycopg://agentrank:agentrank@localhost:5432/agentrank
# AGENTRANK_REDIS_URL=redis://localhost:6379/0
# AGENTRANK_USE_QUEUE=true

# ---------- Accounts ----------
# Set to true when the site is served over HTTPS, so the session cookie is only sent securely.
AGENTRANK_COOKIE_SECURE=false

# ---------- Crawling ----------
# AGENTRANK_MAX_PAGES=25
# AGENTRANK_RENDER_JS=true
# AGENTRANK_STORAGE_DIR=./storage

# ---------- PageSpeed Insights (optional) ----------
# Keyless requests are often rate-limited; a free Google API key raises the quota.
# AGENTRANK_PAGESPEED_API_KEY=

# ---------- Agent task tests ----------
# Defaults fit Groq's free tier (8K tokens/min, 200K/day): about 4 runs and 30-50K tokens per audit.
# AGENTRANK_AGENT_TESTS_ENABLED=true
# AGENTRANK_AGENT_MAX_TASKS=2
# AGENTRANK_AGENT_RUNS_PER_TASK=2
# AGENTRANK_AGENT_MAX_STEPS=8

# ---------- AI visibility ----------
# Each search-backed answer costs about 3-25K tokens on Groq; models are queried in parallel.
# AGENTRANK_VISIBILITY_ENABLED=true
# AGENTRANK_VISIBILITY_PROMPTS=6
# AGENTRANK_VISIBILITY_SAMPLES=1
# AGENTRANK_VISIBILITY_MODELS=["openai/gpt-oss-120b","openai/gpt-oss-20b"]
# AGENTRANK_VISIBILITY_TOKEN_BUDGET=40000
